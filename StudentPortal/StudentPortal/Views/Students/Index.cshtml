@model List<Student>

@{
    ViewData["Title"] = "Students";
    var q = (ViewBag.Query as string) ?? "";
    var total = Model?.Count ?? 0;
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="mb-0">Students <small class="text-muted fs-6">(@total)</small></h2>
                    <p class="text-muted mb-0">Manage students — add, edit, delete and search in real time</p>
                </div>
                <div class="ms-3">
                    <a class="btn btn-primary btn-sm px-3" asp-action="Create">+ Add Student</a>
                </div>
            </div>

            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-6">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white border-end-0">
                            <!-- simple magnifier SVG -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242 0a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/>
                            </svg>
                        </span>
                        <input id="q" class="form-control border-start-0" placeholder="Search by name, email or status" value="@q" />
                        <button id="btnSearch" class="btn btn-outline-primary" type="button">Search</button>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <div id="liveBox" class="text-muted small"></div>
                </div>
            </div>

            <div class="table-responsive shadow-sm">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px">Id</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th style="width:140px">Status</th>
                            <th style="width:180px">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tblBody">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted p-4">No students found. <a asp-action="Create">Add a new student</a> to get started.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var s in Model)
                            {
                                <tr>
                                    <td>@s.StudentId</td>
                                    <td class="fw-semibold">@s.FullName</td>
                                    <td>@s.Email</td>
                                    <td>
                                        @if (s.Status == "Active")
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else if (s.Status == "Inactive")
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@s.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-warning me-1" asp-action="Edit" asp-route-id="@s.StudentId">Edit</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.StudentId">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            let timeout = null;

            function renderRows(items) {
                if (!items || items.length === 0) {
                    $("#tblBody").html(
                        `<tr><td colspan="5" class="text-center text-muted">No results found</td></tr>`
                    );
                    return;
                }

                let rows = "";

                $.each(items, function (i, s) {

                    let badgeClass = "bg-warning text-dark";

                    if (s.status === "Active")
                        badgeClass = "bg-success";
                    else if (s.status === "Inactive")
                        badgeClass = "bg-danger";

                    rows += `
                        <tr>
                            <td>${s.studentId}</td>
                            <td>${s.fullName}</td>
                            <td>${s.email}</td>
                            <td><span class="badge ${badgeClass}">${s.status ?? ""}</span></td>
                            <td>
                                <a class="btn btn-sm btn-warning"
                                   href="/Students/Edit/${s.studentId}">Edit</a>
                                <a class="btn btn-sm btn-danger"
                                   href="/Students/Delete/${s.studentId}">Delete</a>
                            </td>
                        </tr>
                    `;
                });

                $("#tblBody").html(rows);
            }

            function liveSearch() {
                 const q = $("#q").val().trim();

                $("#liveBox").text("Loading...");

                $.get("/Students/Search", { q: q }, function (data) {

                    if (q.length === 0) {
                         $("#liveBox").text("");
                    } else {
                        $("#liveBox").text("Found: " + data.length);
                    }

                    renderRows(data);

                });
            }

            $("#q").on("keyup", function () {
                clearTimeout(timeout);
                timeout = setTimeout(liveSearch, 300);
            });

            $("#btnSearch").click(liveSearch);

        });
    </script>
}
